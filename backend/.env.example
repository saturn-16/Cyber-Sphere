# CyberSphere Environment Variables
# Copy this file to .env and fill in your real values

# ── JWT Configuration ──────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRE_HOURS=24

# ── Database ───────────────────────────────────────
# Local: leave empty (uses SQLite)
# Production (Supabase): postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ── VirusTotal API ─────────────────────────────────
# Get free key at: https://www.virustotal.com/gui/sign-in
VIRUSTOTAL_API_KEY=

# ── Google Safe Browsing API ───────────────────────
# Get free key at: https://console.cloud.google.com/
SAFE_BROWSING_API_KEY=

# ── AbuseIPDB API ──────────────────────────────────
# Get free key at: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=

# ── File Storage (Cloudflare R2 or Supabase Storage)
STORAGE_BUCKET=cybersphere-files
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── AES Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# ── SMTP Email Configuration ───────────────────────
# Enter your Gmail and Gmail App Password to enable notifications
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

